#!/bin/sh
# Global commit-msg hook, installed with:
#   git config --global core.hooksPath ~/.claude/hooks/git
#
# Enforces the non-negotiable rule from ~/.claude/CLAUDE.md: a commit message
# is a single subject line, with no body and no trailers. Comment lines and
# everything below the --verbose scissors line are ignored, as git strips them.
#
# A global core.hooksPath stops git from running a repository's own
# .git/hooks, so after the check this forwards to the repository's commit-msg.

msg_file="$1"

comment_char=$(git config --get core.commentChar)
case "$comment_char" in
  "" | auto) comment_char="#" ;;
esac

lines=$(awk -v cc="$comment_char" '
  index($0, cc " ------------------------ >8 ------------------------") == 1 { exit }
  index($0, cc) == 1 { next }
  { sub(/[ \t\r]+$/, ""); if (length($0) > 0) n++ }
  END { print n + 0 }
' "$msg_file")

if [ "$lines" -ne 1 ]; then
  echo "commit-msg: rejected. The message must be a single subject line, with no body and no trailers ($lines non-empty lines found)." >&2
  exit 1
fi

repo_hook="$(git rev-parse --git-common-dir)/hooks/commit-msg"
[ -x "$repo_hook" ] && exec "$repo_hook" "$@"
exit 0
