{
  "agentPushNotifEnabled": true,
  "alwaysThinkingEnabled": true,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: rdrkr/dotfiles — PUBLIC (confirmed via gh)",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: Default branch `main`; no rulesets or protected branches listed for rdrkr/dotfiles",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Host containment**: None configured — assume Claude Code runs on an ordinary developer machine or CI runner with open internet",
      "**Source control**: The trusted repo rdrkr/dotfiles (github.com:rdrkr/dotfiles.git) and its remote(s) only (no additional orgs configured)",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development (personal dotfiles management)",
      "**Trusted repo**: rdrkr/dotfiles (github.com:rdrkr/dotfiles.git), the git repository this session started in — PUBLIC, so only this repo's own work belongs in it; secrets and sensitive data are never cleared into it regardless of visibility",
      "**Org-specific CLIs**: None configured",
      "Routine actions under this repo's own paths (e.g. `~/dotfiles/.config/rex`) may be treated as low-risk local operations; nothing else is scoped this way"
    ]
  },
  "autoUpdatesChannel": "latest",
  "effortLevel": "high",
  "enabledPlugins": {
    "chrome-devtools-mcp@chrome-devtools-plugins": true,
    "clangd-lsp@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "kotlin-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "telegram@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "env": {},
  "extraKnownMarketplaces": {
    "chrome-devtools-plugins": {
      "source": {
        "repo": "ChromeDevTools/chrome-devtools-mcp",
        "source": "github"
      }
    }
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "~/dotfiles/scripts/notify.sh --title 'Claude Code — Needs Input' --message 'Claude is waiting for your input' --sound Ping --app-icon ~/dotfiles/scripts/icons/claude.png",
            "type": "command"
          }
        ],
        "matcher": "permission_prompt"
      },
      {
        "hooks": [
          {
            "command": "~/dotfiles/scripts/notify.sh --title 'Claude Code — Needs Input' --message 'Claude is waiting for your input' --sound Ping --app-icon ~/dotfiles/scripts/icons/claude.png",
            "type": "command"
          }
        ],
        "matcher": "auth_success"
      },
      {
        "hooks": [
          {
            "command": "~/dotfiles/scripts/notify.sh --title 'Claude Code — Needs Input' --message 'Claude is waiting for your input' --sound Ping --app-icon ~/dotfiles/scripts/icons/claude.png",
            "type": "command"
          }
        ],
        "matcher": "elicitation_dialog"
      },
      {
        "hooks": [
          {
            "_rootshell": "push",
            "async": true,
            "command": "rootshell-notify hook --agent claude-code",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "atuin hook claude-code",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "command": "atuin hook claude-code",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "atuin hook claude-code",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "node ~/.claude/hooks/git-rules.js",
            "onFailure": "block",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "Bash|PowerShell"
      },
      {
        "hooks": [
          {
            "_rootshell": "push",
            "async": true,
            "command": "rootshell-notify hook --agent claude-code",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "AskUserQuestion"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "[ -n \"$TMUX\" ] && tmux rename-window -t \"$TMUX_PANE\" \"Claude\" || true",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "/bin/sh -c 'rex __internal session-start --agent claude --feature-session-naming=false 2>/dev/null || true'",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "~/dotfiles/scripts/notify.sh --title 'Claude Code — Done' --message 'Claude has finished and is awaiting further instructions' --sound Glass --app-icon ~/dotfiles/scripts/icons/claude.png",
            "type": "command"
          },
          {
            "command": "[ -n \"$TMUX\" ] && tmux rename-window -t \"$TMUX_PANE\" \"Claude\" || true",
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "_rootshell": "push",
            "async": true,
            "command": "rootshell-notify hook --agent claude-code",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  },
  "model": "opus",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "permissions": {
    "allow": [
      "Bash(command -v:*)",
      "Bash(curl:*)",
      "Read(///**)",
      "Read(//private/tmp/**)",
      "WebFetch(domain:eslint.org)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:redocly.com)",
      "WebFetch(domain:strapi.io)",
      "WebFetch(domain:typescript-eslint.io)",
      "WebSearch"
    ],
    "ask": [],
    "defaultMode": "auto",
    "deny": []
  },
  "remoteControlAtStartup": false,
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "command": "~/.claude/statusline-command.js",
    "type": "command"
  },
  "switchModelsOnFlag": false,
  "theme": "dark",
  "tui": "fullscreen"
}
