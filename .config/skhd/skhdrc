# This file was generated based on .aerospace.toml
# Some bindings may not have a direct equivalent in yabai and are commented out.

# --- Main Mode ---

# Focus window
ctrl - left : yabai -m window --focus west
ctrl - down : yabai -m window --focus south
ctrl - up : yabai -m window --focus north
ctrl - right : yabai -m window --focus east

# Focus workspace
ctrl - 1 : yabai -m space --focus 1
ctrl - 2 : yabai -m space --focus 2
ctrl - 3 : yabai -m space --focus 3
ctrl - 4 : yabai -m space --focus 4
ctrl - 5 : yabai -m space --focus 5

# Focus next/prev workspace (non-empty workspace logic from aerospace is not replicated)
ctrl + alt - right : yabai -m space --focus next || yabai -m space --focus first
ctrl + alt - left : yabai -m space --focus prev || yabai -m space --focus last

# Move window
ctrl + shift - left : yabai -m window --swap west
ctrl + shift - down : yabai -m window --swap south
ctrl + shift - up : yabai -m window --swap north
ctrl + shift - right : yabai -m window --swap east

# Move window to workspace
ctrl + shift - 1 : yabai -m window --space 1
ctrl + shift - 2 : yabai -m window --space 2
ctrl + shift - 3 : yabai -m window --space 3
ctrl + shift - 4 : yabai -m window --space 4
ctrl + shift - 5 : yabai -m window --space 5

# 'join-with' is not directly supported in yabai.
# ctrl + alt + shift - left : ...
# ctrl + alt + shift - down : ...
# ctrl + alt + shift - up : ...
# ctrl + alt + shift - right : ...

# Resize window (aerospace 'smart' resize is context-aware, this is a basic equivalent)
ctrl - minus : yabai -m window --resize left:-50:0
ctrl - equal : yabai -m window --resize right:50:0

# To disable cmd-h and cmd-alt-h, you should re-map them in macOS
# System Settings > Keyboard > Shortcuts, as skhd cannot unset system bindings.

# Layout management
alt - slash : yabai -m space --toggle split # Toggles split direction for next window
alt - comma : yabai -m space --layout stack # Switch to stack layout

# --- Service Mode ---
# Enter service mode
alt + shift - semicolon : skhd -k "mode service"

:service <<<
    # Exit service mode
    escape : skhd -k "mode default"

    # Balance workspace tree
    r : yabai -m space --balance; skhd -k "mode default"

    # Toggle float
    f : yabai -m window --toggle float; skhd -k "mode default"

    # 'close-all-windows-but-current' is not mapped due to complexity.
    # It would require a separate shell script.

    # Volume controls
    down : osascript -e "set volume output volume (output volume of (get volume settings) - 5)"
    up : osascript -e "set volume output volume (output volume of (get volume settings) + 5)"
    shift - down : osascript -e "set volume output volume 0"; skhd -k "mode default"
:service >>>