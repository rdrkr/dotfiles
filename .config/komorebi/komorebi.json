{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.40/schema.json",
  "app_specific_configuration_path": "C:/Users/rdruker/.config/komorebi/applications.json",
  "window_hiding_behaviour": "Cloak",
  "cross_monitor_move_behaviour": "Insert",
  "default_workspace_padding": 16,
  "default_container_padding": 16,
  "unmanaged_window_operation_behaviour": "Op",
  "resize_delta": 100,
  "animation": {
    "enabled": false
  },
  "theme": {
    "palette": "Base16",
    "name": "GruvboxDarkMedium",
    "bar_accent": "Base06",
    "floating_border": "Base06",
    "monocle_border": "Base06",
    "single_border": "Base06",
    "unfocused_border": "Base00"
  },
  "stackbar": {
    "mode": "Never"
  },
  "border": true,
  "border_width": 5,
  "border_offset": -1,
  "border_implementation": "Windows",
  "border_style": "Rounded",
  "monitors": [
    {
      "workspaces": [
        {
          "name": "1",
          "layout_rules": {
            "1": "BSP",
            "4": "Grid"
          },
          "workspace_rules": [
            {
              "id": "(?i)safari|chrome",
              "kind": "Exe",
              "matching_strategy": "Regex"
            }
          ]
        },
        {
          "name": "2",
          "layout_rules": {
            "1": "BSP",
            "4": "Grid"
          },
          "workspace_rules": [
            {
              "id": "TscShellContainerClass",
              "kind": "Class",
              "matching_strategy": "Equals"
            },
            {
              "id": "(?i)mstsc|msrdcw|rdclient",
              "kind": "Exe",
              "matching_strategy": "Regex"
            }
          ]
        },
        {
          "name": "3",
          "layout_rules": {
            "1": "BSP",
            "4": "Grid"
          },
          "workspace_rules": [
            {
              "id": "(?i)intellij|idea|xcode|visual|android|studio64|devenv",
              "kind": "Exe",
              "matching_strategy": "Regex"
            }
          ]
        },
        {
          "name": "4",
          "layout_rules": {
            "1": "BSP",
            "4": "Grid"
          },
          "workspace_rules": []
        },
        {
          "name": "5",
          "layout_rules": {
            "1": "BSP",
            "4": "Grid"
          },
          "workspace_rules": [
            {
              "id": "(?i)outlook|teams",
              "kind": "Exe",
              "matching_strategy": "Regex"
            }
          ]
        },
        {
          "name": "6",
          "layout_rules": {
            "1": "BSP",
            "4": "Grid"
          },
          "workspace_rules": [
            {
              "id": "(?i)messages|whatsapp|beeper|phone",
              "kind": "Exe",
              "matching_strategy": "Regex"
            }
          ]
        }
      ]
    }
  ],
  "floating_applications": [
    {
      "id": "(?i)mail|contacts|facetime|quicktime|finder|ollama|calendar|activity|gpt|chatgpt|preview|photos|podcasts|perplexity|store|java|passwords|pearcleaner|reminders|sf symbols|teamviewer",
      "kind": "Exe",
      "matching_strategy": "Regex"
    },
    {
      "id": "msrdc.exe",
      "kind": "Exe",
      "matching_strategy": "Equals"
    },
    {
      "id": "mintty.exe",
      "kind": "Exe",
      "matching_strategy": "Equals"
    },
    {
      "id": "[Pp]icture.in.[Pp]icture",
      "kind": "Title",
      "matching_strategy": "Regex"
    }
  ],
  "ignore_rules": [
    {
      "id": "(?i)vlc|helper",
      "kind": "Exe",
      "matching_strategy": "Regex"
    }
  ]
}
