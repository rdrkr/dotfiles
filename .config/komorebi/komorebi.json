{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.40/schema.json",
  "app_specific_configuration_path": "C:/Users/ronen/.config/komorebi/applications.json",
  "window_hiding_behaviour": "Cloak",
  "cross_monitor_move_behaviour": "Insert",
  "default_workspace_padding": 16,
  "default_container_padding": 16,
  "animation": {
    "enabled": true
  },
  "border": true,
  "border_width": 5,
  "border_offset": -1,
  "border_colours": {
    "single": "#ebdbb2",
    "stack": "#ebdbb2",
    "monocle": "#ebdbb2"
  },
  "border_implementation": "Windows",
  "border_style": "Rounded",
  "unfocused_window_border_colours": {
    "single": "#000000",
    "stack": "#000000",
    "monocle": "#000000"
  },
  "monitors": [
    {
      "workspaces": [
        {
          "name": "1",
          "layout": "BSP"
        },
        {
          "name": "2",
          "layout": "BSP"
        },
        {
          "name": "3",
          "layout": "BSP"
        },
        {
          "name": "4",
          "layout": "BSP"
        },
        {
          "name": "5",
          "layout": "BSP"
        },
        {
          "name": "6",
          "layout": "BSP"
        }
      ]
    }
  ],
  "workspace_rules": [
    {
      "id": "(?i)safari|chrome",
      "kind": "Exe",
      "matching_strategy": "Regex",
      "workspace": "1"
    },
    {
      "id": "(?i)terminal|warp",
      "kind": "Exe",
      "matching_strategy": "Regex",
      "workspace": "2"
    },
    {
      "id": "(?i)intellij|idea|xcode|visual|android|studio64",
      "kind": "Exe",
      "matching_strategy": "Regex",
      "workspace": "3"
    },
    {
      "id": "(?i)messages|whatsapp|beeper",
      "kind": "Exe",
      "matching_strategy": "Regex",
      "workspace": "5"
    }
  ],
  "manage_rules": [
    {
      "id": "WindowsTerminal.exe",
      "kind": "Exe",
      "matching_strategy": "Equals"
    },
    {
      "id": "(?i)warp.exe",
      "kind": "Exe",
      "matching_strategy": "Regex"
    }
  ],
  "layered_applications": [
    {
      "id": "WindowsTerminal.exe",
      "kind": "Exe",
      "matching_strategy": "Equals"
    },
    {
      "id": "(?i)warp.exe",
      "kind": "Exe",
      "matching_strategy": "Regex"
    }
  ],
  "ignore_rules": [
    {
      "id": "(?i)mail|contacts|phone|facetime|quicktime|finder|ollama|calendar|activity|gpt|chatgpt|preview|photos|podcasts|perplexity|store|java|passwords|pearcleaner|reminders|sf symbols|teamviewer",
      "kind": "Exe",
      "matching_strategy": "Regex"
    },
    {
      "id": "[Pp]icture.in.[Pp]icture",
      "kind": "Title",
      "matching_strategy": "Regex"
    }
  ]
}
