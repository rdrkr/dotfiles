{
  "$schema": "https://github.com/glzr-io/zebar/raw/v3.1.0/resources/zpack-schema.json",
  "name": "gruvbox",
  "version": "0.0.1",
  "description": "",
  "tags": [
    "workspaces",
    "groovbox",
    "media",
    "glazewm"
  ],
  "previewImages": [
    ""
  ],
  "repositoryUrl": "https://github.com/zacccharv/zebar-gruvbox",
  "widgets": [
    {
      "name": "groovbox",
      "htmlPath": "./dist/src/widgets/bar/glazewm/index.html",
      "zOrder": "normal",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": false,
      "transparent": true,
      "includeFiles": [
        "dist/**/*"
      ],
      "caching": {
        "defaultDuration": 604800,
        "rules": []
      },
      "privileges": {
        "shellCommands": [
          {
            "program": "powershell",
            "argsRegex": "^-NoProfile -Command \\$r=0"
          }
        ]
      },
      "presets": [
        {
          "name": "default",
          "anchor": "top_center",
          "offsetX": "0px",
          "offsetY": "0px",
          "width": "100%",
          "height": "40px",
          "monitorSelection": {
            "type": "all"
          },
          "dockToEdge": {
            "enabled": true,
            "edge": "top",
            "windowMargin": "0px"
          }
        }
      ]
    }
  ]
}
