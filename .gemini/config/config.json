{
  "plugins": {
    "android-cli-plugin": {
      "enabled": true
    },
    "chrome-devtools-plugin": {
      "enabled": true
    },
    "modern-web-guidance-plugin": {
      "enabled": true
    },
    "swarm": {
      "enabled": true
    }
  },
  "userSettings": {
    "globalPermissionGrants": {
      "allow": [
        "command(head)",
        "command(dns-sd)",
        "command(sleep)",
        "command(wait)",
        "command(git status)",
        "command(git add)",
        "command(git commit)"
      ]
    }
  }
}