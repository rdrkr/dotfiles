# npm user config, stowed to ~/.npmrc on every OS (install.ps1 hardlinks it on Windows).
# This repo is public: never put registry auth tokens here.

# Packages whose install scripts may run (npm 11+). Anything not listed installs with its
# scripts skipped, so `ua` never needs --dangerously-allow-all-scripts. Entries for packages
# that are not installed on a given OS (e.g. fsevents on Linux) are ignored.
allow-scripts=esbuild,node-pty,@github/keytar,@homebridge/node-pty-prebuilt-multiarch,macos-temperature-sensor,osx-temperature-sensor,@scarf/scarf,fsevents,unrs-resolver,pnpm,ffmpeg-for-homebridge
