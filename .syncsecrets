# .syncsecrets - files dotfiles-sync carries between the machines encrypted,
# outside git (scripts/dotfiles-sync-secrets.js). One repo-relative path per
# line, no globs. Every path must also be in .gitignore; a receiving repo only
# writes the paths its own copy of this file lists.
#
# Set up once: 'dotfiles-sync secrets init' on one machine, then
# 'dotfiles-sync secrets show-key' there and 'dotfiles-sync secrets set-key' on
# the other.

# claude.ai session keys the status line's usage fetcher (.claude/fetch-claude-usage.js)
# reads. The .usage-cache-*/.usage-cookies-* files next to it are rebuilt on each
# machine and are deliberately not synced.
.claude/usage-secrets.json
